<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tupfer.Designer.ViewModels"
             xmlns:svc="using:Tupfer.Designer.Services"
             x:Class="Tupfer.Designer.Views.PenManagerView"
             x:DataType="vm:PenManagerViewModel">
  <!-- Stift-Manager: am Desktop in einem eigenen Fenster, im Browser als Ebene über der Ansicht -->
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
        <Button Content="Ordner wählen …" Command="{Binding PickFolderCommand}" IsVisible="{x:Static vm:PenManagerViewModel.CanPickFolder}"
                ToolTip.Tip="Laufwerk des Stifts von Hand wählen (z. B. wenn er sich nicht als „tiptoi“ meldet)" />
        <Button Content="Neu einlesen" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"
                ToolTip.Tip="Erneut nach Stiften suchen und die Dateien einlesen" />
      </StackPanel>
      <TextBlock Text="Stift:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" HorizontalAlignment="Stretch"
                IsVisible="{Binding HasDrive}" ToolTip.Tip="Stift bzw. Ordner, der angezeigt wird">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="svc:IPenDrive">
            <TextBlock Text="{Binding Name}" TextTrimming="LeadingCharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="keiner gefunden" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                 IsVisible="{Binding !HasDrive}" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                 IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
          <Button Content="Abbrechen" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
          <Button Content="Schließen" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"
                  Command="{Binding CloseCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Width="160" IsVisible="{Binding HasProgress}" />
          <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <TabControl SelectedIndex="{Binding SelectedTab}">
      <!-- Dateien auf dem Stift -->
      <TabItem Header="Auf dem Stift">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
            <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{x:Static vm:PenManagerViewModel.ShowBrowserPenHint}"
                       Text="Die Web-Version findet den Stift nicht von selbst. In Chrome und Edge lässt sich sein Laufwerk mit „Ordner wählen …“ freigeben; den freien Speicher verrät der Browser nicht." />
            <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{x:Static vm:PenManagerViewModel.CannotPickFolder}"
                       Text="Dieser Browser kann nicht auf Ordner zugreifen (nur Chrome und Edge am PC). Für den Stift bitte die Desktop-Version nutzen." />
            <DockPanel IsVisible="{Binding HasDrive}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding SpaceText}" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="{Binding PenSummary}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedFraction}" Height="6" IsVisible="{Binding HasDrive}"
                         ToolTip.Tip="Belegter Speicher des Stifts" />
            <Border Background="{DynamicResource WarningBackground}" CornerRadius="6" Padding="10,6"
                    IsVisible="{Binding Warnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Foreground="{DynamicResource WarningForeground}" />
            </Border>
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding PenItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PenItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                    <Border Padding="6,2" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="110"
                            Background="{DynamicResource CardBorder}">
                      <TextBlock Text="{Binding Kind}" FontSize="11" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Update verfügbar" Foreground="{DynamicResource WarningForeground}" IsVisible="{Binding UpdateAvailable}" />
                        <TextBlock Text="doppelte Produkt-ID" Foreground="{DynamicResource DangerForeground}" IsVisible="{Binding IsDuplicate}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="Aktualisieren" IsVisible="{Binding UpdateAvailable}"
                              Command="{Binding $parent[ItemsControl].((vm:PenManagerViewModel)DataContext).UpdateItemCommand, FallbackValue={x:Null}}"
                              CommandParameter="{Binding}" ToolTip.Tip="Aktuelle Fassung von Ravensburger laden und ersetzen" />
                      <Button Content="Löschen" Classes="danger"
                              Command="{Binding $parent[ItemsControl].((vm:PenManagerViewModel)DataContext).DeleteCommand, FallbackValue={x:Null}}"
                              CommandParameter="{Binding}" ToolTip.Tip="Datei vom Stift löschen (mit Rückfrage)" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Offizielle Produkte von Ravensburger -->
      <TabItem Header="Ravensburger-Katalog">
        <Panel Margin="0,8,0,0">
          <!-- Web-Version: kein Zugriff auf die Ravensburger-Server (CORS) -->
          <StackPanel Spacing="10" IsVisible="{x:Static vm:PenManagerViewModel.CatalogUnavailable}">
            <TextBlock TextWrapping="Wrap"
                       Text="Katalog und Download der Ravensburger-Produkte gibt es nur in der Desktop-Version: Die Ravensburger-Server erlauben Web-Seiten keinen Zugriff (CORS)." />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Von Hand geht es so: Ravensburger-Seite öffnen, beim Produkt auf das Bild klicken, die GME-Datei speichern und auf das Laufwerk des Stifts kopieren." />
            <Button Content="Ravensburger-Audiodateien öffnen" Command="{Binding OpenRavensburgerPageCommand}" />
          </StackPanel>

          <DockPanel IsVisible="{x:Static vm:PenManagerViewModel.CatalogAvailable}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                <CheckBox Content="Nur Updates" IsChecked="{Binding OnlyUpdates}" />
                <Button Content="Katalog aktualisieren" Command="{Binding LoadCatalogCommand}" IsEnabled="{Binding IsIdle}"
                        ToolTip.Tip="Produktliste neu von den Ravensburger-Service-Seiten laden (dauert etwa eine Minute)" />
              </StackPanel>
              <TextBox Text="{Binding SearchText}" PlaceholderText="Suchen: Titel, Artikelnummer, Rubrik oder Produkt-ID …" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Ravensburger-Seite" Command="{Binding OpenRavensburgerPageCommand}" Padding="8,2"
                      ToolTip.Tip="Quelle: tiptoi-Audiodateien im Ravensburger-Serviceportal" />
              <TextBlock Classes="hint" Text="{Binding CatalogInfo}" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer>
              <!-- Kacheln mit großem Produktbild -->
              <ItemsControl ItemsSource="{Binding CatalogItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CatalogItem">
                    <Border Width="200" Margin="0,0,10,10" Padding="8" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource CardBorder}" ToolTip.Tip="{Binding ToolTip}">
                      <StackPanel Spacing="4">
                        <Panel>
                          <Border Height="184" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource CardBorder}">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                          </Border>
                          <!-- Stand auf dem Stift als Plakette oben rechts -->
                          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4"
                                  Background="{DynamicResource SuccessBackground}" IsVisible="{Binding IsInstalled}">
                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource SuccessForeground}" />
                          </Border>
                          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4"
                                  Background="{DynamicResource WarningBackground}" IsVisible="{Binding HasUpdate}">
                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource WarningForeground}" />
                          </Border>
                        </Panel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" Height="36" />
                        <TextBlock Text="{Binding TileDetails}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" MaxLines="2" Height="30" />
                        <Button Content="{Binding ActionText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                IsVisible="{Binding CanInstall}"
                                IsEnabled="{Binding $parent[ItemsControl].((vm:PenManagerViewModel)DataContext).IsIdle, FallbackValue=False}"
                                Command="{Binding $parent[ItemsControl].((vm:PenManagerViewModel)DataContext).InstallCommand, FallbackValue={x:Null}}"
                                CommandParameter="{Binding}" ToolTip.Tip="Von Ravensburger laden und auf den Stift legen" />
                        <!-- Gleiche Höhe wie der Knopf, damit die Kacheln einer Reihe gleich hoch sind -->
                        <TextBlock Text="ist aktuell" Height="32" Padding="0,7,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding IsInstalled}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Panel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
