<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Tupfer.Designer</RootNamespace>
    <ApplicationIcon>Assets\Tupfer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Tupfer.ico;Assets\Tupfer.png" />
    <EmbeddedResource Include="Oid\KnownCodes.txt" LogicalName="KnownCodes.txt" />
    <!-- Personenerkennung (RF-DETR-Seg von Roboflow, Apache 2.0, und YuNet von OpenCV Zoo, MIT;
         Umwandlung: tools/personen-modell) -->
    <EmbeddedResource Include="Assets\personen.onnx" LogicalName="personen.onnx" />
    <EmbeddedResource Include="Assets\gesichter.onnx" LogicalName="gesichter.onnx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Aufnahmen als Ogg Vorbis (MIT, reines C#, auch im Browser) -->
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <!-- Direkt drucken unter Windows (GDI+), ohne PDF-Programm -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>


  <!-- ONNX Runtime (Piper-Stimmen) legt seine Windows-DLLs immer bei; für Linux und macOS weglassen -->
  <Target Name="OnnxRuntimeNurFuerWindows" BeforeTargets="AssignTargetPaths"
          Condition="'$(RuntimeIdentifier)' != '' AND !$(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <None Remove="@(None)" Condition="'%(None.Link)' == 'onnxruntime.dll' OR '%(None.Link)' == 'onnxruntime_providers_shared.dll'" />
    </ItemGroup>
  </Target>

</Project>
