<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TipToy.Designer.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <!-- Farben -->
    <SolidColorBrush x:Key="AppBackground" Color="#F3F4F7" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E2E5EB" />
    <SolidColorBrush x:Key="CanvasBackground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1F2A44" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="Brand" Color="#E8590C" />

    <!-- Symbole (Material Design Icons, 24×24) -->
    <StreamGeometry x:Key="IconNew">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M11,11H13V14H16V16H13V19H11V16H8V14H11V11Z</StreamGeometry>
