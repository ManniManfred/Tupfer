  "Scripts": [
    {
      "Name": "suchspiel",
      "Lines": [
        "$frage := 1 P(los) J(frage)"
      ]
    },
    {
      "Name": "nochmal",
      "Lines": [
        "$ziel == 0? P(lupe_tippen)",
        "J(frage)"
      ]
    },
    {
      "Name": "frage",
      "Lines": [
        "$runde == 0? $frage == 1? $ziel := 3 P(wo_kuh)",
        "$runde == 0? $frage == 2? $ziel := 1 P(wo_katze)",
        "$runde == 0? $frage == 3? $ziel := 8 P(wo_huhn)",
        "$runde == 0? $frage == 4? $ziel := 2 P(wo_hund)",
        "$runde == 0? $frage == 5? $ziel := 7 P(wo_schaf)",
        "$runde == 0? $frage == 6? $ziel := 4 P(wo_ente)",
        "$runde == 0? $frage == 7? $ziel := 6 P(wo_schwein)",
        "$runde == 0? $frage == 8? $ziel := 5 P(wo_pferd)",
        "$runde == 1? $frage == 1? $ziel := 4 P(wo_ente)",
        "$runde == 1? $frage == 2? $ziel := 5 P(wo_pferd)",
        "$runde == 1? $frage == 3? $ziel := 1 P(wo_katze)",
        "$runde == 1? $frage == 4? $ziel := 7 P(wo_schaf)",
        "$runde == 1? $frage == 5? $ziel := 2 P(wo_hund)",
        "$runde == 1? $frage == 6? $ziel := 6 P(wo_schwein)",
        "$runde == 1? $frage == 7? $ziel := 3 P(wo_kuh)",
        "$runde == 1? $frage == 8? $ziel := 8 P(wo_huhn)"
      ]
    },
    {
      "Name": "weiter",
      "Lines": [
        "$frage == 9? $runde == 0? $ziel := 0 $runde := 1 P(geschafft)",
        "$frage == 9? $ziel := 0 $runde := 0 P(geschafft)",
        "J(frage)"
      ]
    },
    {
      "Name": "katze",
      "Lines": [
        "$ziel == 0? P(das_ist_katze)",
        "$ziel == 1? $frage += 1 P(richtig1, richtig2, richtig3) J(weiter)",
        "P(das_ist_katze) J(frage)"
      ]
    },
    {
      "Name": "hund",
      "Lines": [
        "$ziel == 0? P(das_ist_hund)",
        "$ziel == 2? $frage += 1 P(richtig1, richtig2, richtig3) J(weiter)",
        "P(das_ist_hund) J(frage)"
      ]
    },
    {
