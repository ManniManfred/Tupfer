    <StreamGeometry x:Key="IconCrop">M7,17V1H5V5H1V7H5V17A2,2 0 0,0 7,19H17V23H19V19H23V17M17,15H19V7C19,5.89 18.1,5 17,5H9V7H17V15Z</StreamGeometry>
    <StreamGeometry x:Key="IconMic">M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M18,18H6V6H18V18Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
    <StreamGeometry x:Key="IconPan">M13,11H18L16.5,9.5L17.92,8.08L21.84,12L17.92,15.92L16.5,14.5L18,13H13V18L14.5,16.5L15.92,17.92L12,21.84L8.08,17.92L9.5,16.5L11,18V13H6L7.5,14.5L6.08,15.92L2.16,12L6.08,8.08L7.5,9.5L6,11H11V6L9.5,7.5L8.08,6.08L12,2.16L15.92,6.08L14.5,7.5L13,6V11Z</StreamGeometry>
    <StreamGeometry x:Key="IconFit">M2,5H6V3H2A2,2 0 0,0 0,5V9H2V5M22,3H18V5H22V9H24V5A2,2 0 0,0 22,3M2,15H0V19A2,2 0 0,0 2,21H6V19H2V15M22,19H18V21H22A2,2 0 0,0 24,19V15H22V19M7,12L10,9V11H14V9L17,12L14,15V13H10V15L7,12Z</StreamGeometry>
    <StreamGeometry x:Key="IconShapeRect">M2,4H22V20H2V4M4,6V18H20V6H4Z</StreamGeometry>
    <StreamGeometry x:Key="IconShapeCircle">M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z</StreamGeometry>
    <StreamGeometry x:Key="IconShapePolygon">M12,2L22,9.5L18.2,21H5.8L2,9.5Z M12,4.5L4.4,10.3L7.3,19H16.7L19.6,10.3Z</StreamGeometry>
    <StreamGeometry x:Key="IconArea">M3,3H9V5H5V9H3V3M15,3H21V9H19V5H15V3M3,15H5V19H9V21H3V15M19,15H21V21H15V19H19V15Z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#E8590C" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Karten -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
    </Style>

    <!-- Texte -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector=":is(TextBlock).hint">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Schaltflächen -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="Button PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="ToggleButton.tool PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="ToggleButton PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="ToggleButton > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="Button.danger PathIcon">
      <Setter Property="Foreground" Value="#C62828" />
    </Style>
    <Style Selector="WrapPanel.buttons">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="WrapPanel.buttons > Button">
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!-- Ebenen-Liste (Bilder und Texte einer Seite) -->
    <Style Selector="Button.layer">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.layer.selected">
      <Setter Property="Background" Value="#F8C9AE" />
    </Style>

    <!-- Reiter -->
    <Style Selector="TabControl.main > TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
  </Application.Styles>
</Application>
