        "$turn == 2? P(player2wins) $turn := 1 J(reset)"
      ]
    },
    {
      "Name": "reset",
      "Code": 3959,
      "Lines": [
        "$set:=0 $OL:=0 $OM:=0 $OR:=0 $ML:=0 $MM:=0 $MR:=0 J(reset2)"
      ]
    },
    {
      "Name": "reset2",
      "Code": 3960,
      "Lines": [
