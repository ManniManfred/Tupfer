<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Tupfer.Designer</RootNamespace>
    <!-- Nur die Framework-Bibliotheken kürzen; YAML und JSON arbeiten mit Reflection -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Prozesse (tttool, externe Sprachausgabe) werden im Browser nie gestartet; JSON-Typen bleiben erhalten (s. o.) -->
    <NoWarn>$(NoWarn);CA1416;IL2026</NoWarn>
  </PropertyGroup>

  <!-- Der Designer selbst wird aus Tupfer.Designer mitübersetzt (ohne Desktop-Start, Windows-Sprachausgabe und C#-Übersetzer) -->
  <ItemGroup>
    <Compile Include="../Tupfer.Designer/**/*.cs" Exclude="../Tupfer.Designer/bin/**;../Tupfer.Designer/obj/**;../Tupfer.Designer/Program.cs;../Tupfer.Designer/Gme/WindowsSpeech.cs;../Tupfer.Designer/Compiler/ProgramCompiler.cs"
             Link="Designer/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaXaml Include="../Tupfer.Designer/**/*.axaml" Exclude="../Tupfer.Designer/bin/**;../Tupfer.Designer/obj/**"
                  Link="Designer/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="../Tupfer.Designer/Assets/Tupfer.png" Link="Assets/Tupfer.png" />
    <AvaloniaResource Include="../Tupfer.Designer/Assets/Tupfer.ico" Link="Assets/Tupfer.ico" />
    <EmbeddedResource Include="../Tupfer.Designer/Oid/KnownCodes.txt" LogicalName="KnownCodes.txt" />
  </ItemGroup>

  <!-- Beispielprojekte zum direkten Öffnen (Datei → Beispiele), Liste in Examples.cs -->
  <ItemGroup>
    <Content Include="../examples/tic-tac-toi/tic-tac-toi.tupfer.json" Link="wwwroot/examples/tic-tac-toi/tic-tac-toi.tupfer.json" />
    <Content Include="../examples/tic-tac-toi/tic-tac-toi.png" Link="wwwroot/examples/tic-tac-toi/tic-tac-toi.png" />
    <Content Include="../examples/meine-leute/meine-leute.tupfer.json;../examples/meine-leute/foto-*.png" Link="wwwroot/examples/meine-leute/%(Filename)%(Extension)" />
    <Content Include="../examples/wo-ist/*.tupfer.json;../examples/wo-ist/*.png" Exclude="../examples/wo-ist/vorschau.png" Link="wwwroot/examples/wo-ist/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Browser" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

</Project>
