<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tupfer.Designer.ViewModels"
             xmlns:views="using:Tupfer.Designer.Views"
             xmlns:gme="using:Tupfer.Designer.Gme"
             x:Class="Tupfer.Designer.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="{StaticResource AppBackground}">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintPagesCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding BuildGmeCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding SaveToPenCommand}" />
    <KeyBinding Gesture="F8" Command="{Binding ToggleTestModeCommand}" />
    <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding BringForwardCommand}" />
    <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding SendBackwardCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+PageUp" Command="{Binding BringToFrontCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+PageDown" Command="{Binding SendToBackCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- Kompaktes Layout für schmale Bildschirme (Handy): Klasse „compact“ auf der Ansicht, siehe MainView.axaml.cs -->
    <Style Selector=".compact TabControl.main > TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector=".compact TabControl.main">
      <Setter Property="Padding" Value="6,4,6,6" />
    </Style>
    <Style Selector=".compact Menu > MenuItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector=".compact WrapPanel.canvastools TextBlock, .compact WrapPanel.canvastools > Border">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".compact WrapPanel.canvastools :is(Button).tool">
      <Setter Property="Padding" Value="7,6" />
    </Style>
    <Style Selector=".compact StackPanel#CompactBar > ToggleButton">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="TextBox.speakname, TextBlock.speakname">
      <Setter Property="Width" Value="200" />
    </Style>
    <Style Selector=".compact TextBox.speakname, .compact TextBlock.speakname">
      <Setter Property="Width" Value="110" />
    </Style>
    <Style Selector="ComboBox.speakvoice, TextBlock.speakvoice">
      <Setter Property="Width" Value="210" />
    </Style>
    <!-- Spalte nur per Stil (ein lokaler Wert ließe sich auf dem Handy nicht überschreiben) -->
    <Style Selector="Grid.speakrow > TextBox.speaktext, Grid.speakrow > Border.speaktext">
      <Setter Property="Grid.Column" Value="1" />
    </Style>
    <!-- Handy: Sprachausgabe zweizeilig – Name | Stimme, darunter Text | Knöpfe -->
    <Style Selector=".compact Grid.speakheader, .compact TextBlock.desktoponly">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".compact ComboBox.voice">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector=".compact Grid.speakrow > TextBox.speakname">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector=".compact Grid.speakrow > ComboBox.speakvoice">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector=".compact Grid.speakrow > TextBox.speaktext, .compact Grid.speakrow > Border.speaktext">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector=".compact Grid.speakrow > StackPanel.speakbuttons">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Margin" Value="4,6,0,0" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootGrid" RowDefinitions="Auto,*,0,0">

    <!-- ================= Kopfzeile ================= -->
    <Border x:Name="HeaderBar" Grid.Row="0" Background="{StaticResource CardBackground}"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="12,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip.Tip="{x:Static vm:MainWindowViewModel.AppName}">
          <Image Source="/Assets/Tupfer.png" Width="28" Height="28" />
          <StackPanel VerticalAlignment="Center">
            <!-- Version steht im Tooltip und im Fenstertitel -->
            <TextBlock x:Name="AppTitle" Text="Tupfer Designer" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" />
            <!-- Desktop mit eigener Titelleiste: Dateiname statt im Fenstertitel -->
            <TextBlock x:Name="FileTitle" IsVisible="False" Text="{Binding FileName}" FontSize="11"
                       Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
          </StackPanel>
        </StackPanel>

        <!-- Im kompakten Layout statt des Titels nur die Version -->
        <TextBlock x:Name="CompactVersion" Grid.Column="2" IsVisible="False" Text="{x:Static vm:MainWindowViewModel.Version}"
                   FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Margin="4,0,8,0" />

        <Menu x:Name="HeaderMenu" Grid.Column="1" VerticalAlignment="Center">
          <MenuItem Header="_Datei">
            <MenuItem Header="_Neu" InputGesture="Ctrl+N" Command="{Binding NewProjectCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconNew}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Öffnen …" InputGesture="Ctrl+O" Command="{Binding OpenProjectCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconOpen}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Zuletzt geöffnet" IsVisible="{Binding HasRecentProjects}" ItemsSource="{Binding RecentProjects}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:RecentProject">
                  <Setter Property="Header" Value="{Binding Name}" />
                  <Setter Property="ToolTip.Tip" Value="{Binding FilePath}" />
                  <Setter Property="Command" Value="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).OpenRecentCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
            <MenuItem Header="_Speichern" InputGesture="Ctrl+S" Command="{Binding SaveProjectCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconSave}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Speichern _unter …" Command="{Binding SaveProjectAsCommand}" />
            <Separator IsVisible="{x:Static vm:MainWindowViewModel.HasExamples}" />
            <MenuItem Header="_Beispiele" IsVisible="{x:Static vm:MainWindowViewModel.HasExamples}"
                      ItemsSource="{x:Static vm:MainWindowViewModel.Examples}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ExampleProject">
                  <Setter Property="Header" Value="{Binding Title}" />
                  <Setter Property="Command" Value="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).OpenExampleCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
            <Separator />
            <MenuItem Header="tttool-YAML _importieren …" Command="{Binding ImportYamlCommand}" />
            <MenuItem Header="tttool-YAML _exportieren …" Command="{Binding ExportYamlCommand}" />
            <Separator />
            <MenuItem Header="SVG-Grafik i_mportieren …" Command="{Binding ImportSvgCommand}"
                      ToolTip.Tip="Formen, Pfade, Texte und Bilder einer SVG-Datei als Farbflächen, Texte und Bilder auf die Seite holen" />
            <MenuItem Header="Seite als SVG e_xportieren …" Command="{Binding ExportSvgCommand}"
                      ToolTip.Tip="Bilder, Texte und Farbflächen der Seite als SVG; die OID-Flächen liegen auf einer ausgeblendeten Ebene" />
            <Separator IsVisible="{x:Static vm:MainWindowViewModel.HasDownloads}" />
            <MenuItem Header="Desktop-Version _herunterladen …" Command="{Binding ShowDownloadsCommand}"
                      IsVisible="{x:Static vm:MainWindowViewModel.HasDownloads}" />
            <Separator IsVisible="{x:Static vm:MainWindowViewModel.CanUpdate}" />
            <MenuItem Header="Nach neuer _Version suchen …" Command="{Binding CheckForUpdateCommand}"
                      IsVisible="{x:Static vm:MainWindowViewModel.CanUpdate}"
                      ToolTip.Tip="Sucht auf GitHub nach einer neueren Version und installiert sie auf Wunsch" />
            <Separator IsVisible="{x:Static vm:MainWindowViewModel.IsDesktop}" />
            <MenuItem x:Name="QuitItem" Header="_Beenden" InputGesture="Alt+F4"
                      IsVisible="{x:Static vm:MainWindowViewModel.IsDesktop}" />
          </MenuItem>
          <MenuItem Header="_Bearbeiten">
            <MenuItem Header="_Rückgängig" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}"
                      IsEnabled="{Binding Project.History.CanUndo}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconUndo}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Wiederholen" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}"
                      IsEnabled="{Binding Project.History.CanRedo}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconRedo}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Auswahl _löschen" InputGesture="Delete" Command="{Binding DeleteSelectionCommand}"
                      IsEnabled="{Binding Project.SelectedPage.HasSelection, FallbackValue=False}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Alles auswählen" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconSelectMultiple}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="A_usrichten" IsEnabled="{Binding Project.SelectedPage.HasSelection, FallbackValue=False}">
              <MenuItem Header="_Links" Command="{Binding AlignCommand}" CommandParameter="Left">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconAlignLeft}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="_Horizontal zentriert" Command="{Binding AlignCommand}" CommandParameter="CenterX">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconAlignCenterX}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="_Rechts" Command="{Binding AlignCommand}" CommandParameter="Right">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconAlignRight}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="_Oben" Command="{Binding AlignCommand}" CommandParameter="Top">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconAlignTop}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="_Vertikal zentriert" Command="{Binding AlignCommand}" CommandParameter="CenterY">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconAlignCenterY}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="_Unten" Command="{Binding AlignCommand}" CommandParameter="Bottom">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconAlignBottom}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Horizontal _verteilen" Command="{Binding DistributeCommand}" CommandParameter="Horizontal"
                        IsEnabled="{Binding Project.SelectedPage.CanDistribute, FallbackValue=False}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconDistributeX}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Vertikal v_erteilen" Command="{Binding DistributeCommand}" CommandParameter="Vertical"
                        IsEnabled="{Binding Project.SelectedPage.CanDistribute, FallbackValue=False}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconDistributeY}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
            </MenuItem>
            <MenuItem Header="_Reihenfolge" IsEnabled="{Binding Project.SelectedPage.SelectedElement, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
              <MenuItem Header="Ganz nach _vorne" InputGesture="Ctrl+Shift+PageUp" Command="{Binding BringToFrontCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconToFront}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Eine Ebene nach v_orne" InputGesture="Ctrl+PageUp" Command="{Binding BringForwardCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconForward}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Eine Ebene nach _hinten" InputGesture="Ctrl+PageDown" Command="{Binding SendBackwardCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconBackward}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Ganz nach h_inten" InputGesture="Ctrl+Shift+PageDown" Command="{Binding SendToBackCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconToBack}" Width="14" Height="14" /></MenuItem.Icon>
              </MenuItem>
            </MenuItem>
            <Separator />
            <MenuItem Header="_Bild einfügen …" Command="{Binding InsertImageCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconImage}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Bild aus I_mmich …" Command="{Binding InsertImmichImageCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconImage}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Text einfügen" Command="{Binding InsertTextCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconText}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Farbfläche einfügen" Command="{Binding InsertShapeCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconColorShape}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <MenuItem Header="_Erstellen">
            <MenuItem Header="_GME-Datei bauen" InputGesture="F5" Command="{Binding BuildGmeCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Auf den _Stift speichern …" InputGesture="Shift+F5" Command="{Binding SaveToPenCommand}"
                      IsVisible="{x:Static vm:MainWindowViewModel.CanSaveToPen}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconPen}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Testen (Stift simulieren)" InputGesture="F8" ToggleType="CheckBox"
                      IsChecked="{Binding TestMode, Mode=TwoWay}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconTap}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Seiten _drucken …" InputGesture="Ctrl+P" Command="{Binding PrintPagesCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconPrint}" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Seiten als _PDF …" Command="{Binding ExportPdfCommand}" />
            <MenuItem Header="Als _Broschüre"
                      ToolTip.Tip="Je zwei Seiten nebeneinander auf einem Bogen in Heftreihenfolge (z. B. A5-Seiten auf A4 quer), beidseitig zum Falzen und Heften">
              <MenuItem Header="_Drucken …" Command="{Binding PrintBookletCommand}" />
              <MenuItem Header="Als _PDF …" Command="{Binding ExportBookletPdfCommand}" />
            </MenuItem>
            <MenuItem Header="Bilder, Texte und Farbflächen mitdrucken" ToggleType="CheckBox" IsChecked="{Binding PrintElements, Mode=TwoWay}" />
            <MenuItem Header="OID-_Tabelle als PDF …" Command="{Binding ExportOidTableCommand}" />
            <MenuItem Header="Gewählte Fläche als P_NG …" Command="{Binding ExportAreaPngCommand}" />
            <Separator />
            <!-- Eigenes Untermenü, damit es nicht mit „Seiten drucken“ verwechselt wird: gehört nicht zum Projekt -->
            <MenuItem Header="Druc_ker-Testseite (eigenes Produkt 950)"
                      ToolTip.Tip="Feste Testseite unabhängig vom Projekt, um die beste Druckauflösung und Punktgröße zu finden">
              <MenuItem Header="PDF und GME _speichern …" Command="{Binding ExportPrinterTestCommand}"
                        ToolTip.Tip="druckertest.pdf und druckertest.gme speichern; die GME gehört auf den Stift" />
              <MenuItem Header="_Direkt drucken …" Command="{Binding PrintPrinterTestCommand}"
                        IsVisible="{x:Static vm:MainWindowViewModel.CanPrintDirectly}"
                        ToolTip.Tip="Testseite direkt drucken, ohne PDF-Programm, in Originalgröße" />
            </MenuItem>
            <MenuItem Header="Produkte auf dem Stift _anzeigen …" Command="{Binding ShowPenProductsCommand}"
                      IsVisible="{x:Static vm:MainWindowViewModel.IsDesktop}"
                      ToolTip.Tip="Alle GME-Dateien auf dem Stift mit Produkt-ID, um doppelte zu finden" />
            <Separator />
            <MenuItem Header="P_rotokoll anzeigen" ToggleType="CheckBox" IsChecked="{Binding ShowLog, Mode=TwoWay}" />
          </MenuItem>
        </Menu>

        <StackPanel x:Name="HeaderButtons" Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <!-- Im kompakten Layout nur über die Menüs erreichbar -->
          <StackPanel x:Name="HeaderFileButtons" Orientation="Horizontal" Spacing="2">
          <Button Classes="tool" Command="{Binding NewProjectCommand}" ToolTip.Tip="Neues Projekt (Strg+N)">
            <PathIcon Data="{StaticResource IconNew}" />
          </Button>
          <Button Classes="tool" Command="{Binding OpenProjectCommand}" ToolTip.Tip="Projekt öffnen (Strg+O)">
            <PathIcon Data="{StaticResource IconOpen}" />
          </Button>
          <Button Classes="tool" Command="{Binding SaveProjectCommand}" ToolTip.Tip="Speichern (Strg+S)">
            <PathIcon Data="{StaticResource IconSave}" />
          </Button>
          <Border Width="1" Background="{StaticResource CardBorder}" Margin="6,6" />
          <Button Classes="tool" Command="{Binding PrintPagesCommand}" ToolTip.Tip="Seiten drucken (Strg+P)">
            <PathIcon Data="{StaticResource IconPrint}" />
          </Button>
          <Button Classes="tool" Command="{Binding ExportPdfCommand}" ToolTip.Tip="Seiten als PDF">
            <PathIcon Data="{StaticResource IconPdf}" />
          </Button>
          </StackPanel>
          <Button Classes="tool" Command="{Binding SaveToPenCommand}" ToolTip.Tip="GME bauen und auf den Stift speichern (Umschalt+F5)"
                  IsVisible="{x:Static vm:MainWindowViewModel.CanSaveToPen}" Margin="6,0,0,0">
            <PathIcon Data="{StaticResource IconPen}" />
          </Button>
          <Button Classes="accent" Command="{Binding BuildGmeCommand}" ToolTip.Tip="GME-Datei bauen (F5)" Margin="6,0,0,0">
            <PathIcon Data="{StaticResource IconPlay}" />
          </Button>
          <Button x:Name="QuitButton" Classes="tool" ToolTip.Tip="Beenden (Alt+F4)" Margin="6,0,0,0"
                  IsVisible="{x:Static vm:MainWindowViewModel.IsDesktop}">
            <PathIcon Data="{StaticResource IconPower}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Classes="main" SelectedIndex="{Binding SelectedTab}" Padding="12,8,12,12" Margin="0,4,0,0">

      <!-- ================= Seiten ================= -->
      <TabItem Header="Seiten">
        <DockPanel>
        <!-- Nur im kompakten Layout: welcher der drei Bereiche zu sehen ist -->
        <StackPanel x:Name="CompactBar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,6" IsVisible="False">
          <ToggleButton x:Name="ShowCanvas" Content="Seite" IsChecked="True" />
          <ToggleButton x:Name="ShowPages" Content="Seiten" />
          <ToggleButton x:Name="ShowProperties" Content="Auswahl" />
        </StackPanel>
        <Grid x:Name="PagesGrid" ColumnDefinitions="265,12,*,12,290">
          <Border x:Name="PagesPanel" Grid.Column="0" Classes="card" Padding="0">
            <ScrollViewer>
              <StackPanel Margin="14,12">
                <TextBlock Classes="section" Text="Seiten" />
                <ListBox ItemsSource="{Binding Project.Pages}" SelectedItem="{Binding Project.SelectedPage}" MaxHeight="200">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageViewModel">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Classes="buttons">
                  <Button Command="{Binding AddPageCommand}">
                    <StackPanel><PathIcon Data="{StaticResource IconAdd}" /><TextBlock Text="Neue Seite" /></StackPanel>
                  </Button>
                  <Button Classes="danger" Command="{Binding RemovePageCommand}">
                    <StackPanel><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Löschen" /></StackPanel>
                  </Button>
                </WrapPanel>

                <StackPanel DataContext="{Binding Project.SelectedPage}" x:DataType="vm:PageViewModel"
                            IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Classes="label" Text="Name" />
                  <TextBox Text="{Binding Name}" />
                  <TextBlock Classes="label" Text="Breite × Höhe (mm)" />
                  <Grid ColumnDefinitions="*,Auto,*">
                    <TextBox Text="{Binding WidthMm}" />
                    <TextBlock Grid.Column="1" Text=" × " VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding HeightMm}" />
                  </Grid>
                  <StackPanel IsVisible="{Binding HasAnyLayers}">
                    <TextBlock Classes="label" Text="Elemente der Seite (oberstes zuerst)" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Antippen wählt aus, Strg-/Umschalt-Klick mehrere. Zum Umsortieren ziehen, per Finger am Griff. OID-Flächen liegen immer über Bildern und Texten." />
                    <StackPanel IsVisible="{Binding HasAreaLayers}">
                      <TextBlock Classes="sublabel" Text="OID-Flächen" />
                      <ItemsControl x:Name="AreaLayerList" ItemsSource="{Binding AreaLayers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AreaViewModel">
                            <Grid ColumnDefinitions="Auto,*">
                              <Border Classes="draghandle">
                                <PathIcon Data="{StaticResource IconDragHandle}" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                              </Border>
                              <Button Grid.Column="1" Classes="layer" Classes.selected="{Binding IsSelected}"
                                      Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectAreaCommand}"
                                      CommandParameter="{Binding}" ToolTip.Tip="OID-Fläche">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Data="{StaticResource IconArea}" Width="14" Height="14" Foreground="{StaticResource TextSecondary}" />
                                  <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasLayers}">
                      <TextBlock Classes="sublabel" Text="Bilder, Texte und Farbflächen" />
                      <ItemsControl x:Name="LayerList" ItemsSource="{Binding Layers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ElementViewModel">
                            <Grid ColumnDefinitions="Auto,*">
                              <Border Classes="draghandle">
                                <PathIcon Data="{StaticResource IconDragHandle}" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                              </Border>
                              <Button Grid.Column="1" Classes="layer" Classes.selected="{Binding IsSelected}"
                                      Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectElementCommand}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <TextBlock Classes="label" Text="Bedienung" />
                <TextBlock Classes="hint"
                           Text="• Auf freier Stelle ziehen: neue OID-Fläche mit dem gewählten Werkzeug (Rechteck oder Kreis, Umschalt = Quadrat/Kreis; Werkzeug ausschalten: keine neuen Flächen; Farbknopf neben den Werkzeugen: Farbfläche statt OID-Fläche)&#10;• Polygon-Werkzeug: Ecken anklicken, Doppelklick/Eingabe schließt ab, Esc bricht ab&#10;• Bilder aus dem Explorer auf die Seite ziehen: einfügen&#10;• Objekt ziehen: verschieben&#10;• Strg- oder Umschalt-Klick: mehrere Objekte wählen (Strg+A: alle), dann gemeinsam verschieben, ausrichten und verteilen&#10;• Anfasser: Größe ändern (Bilder an den Ecken proportional, Umschalt = frei)&#10;• Runder Griff: drehen (Umschalt = 15°-Schritte)&#10;• „Zuschneiden“: Anfasser schneiden das Bild zu (Form des Zuschnitts: Rechteck, Kreis/Ellipse oder Polygon, bei Polygonen die Ecken ziehen)&#10;• „Nur OID-Flächen“: Bilder und Texte sperren, um darauf Flächen zu zeichnen&#10;• Pfeiltasten: verschieben (Umschalt = 5 mm)&#10;• Entf: löschen&#10;• Strg+Bild↑/↓: Bild oder Text eine Ebene nach vorne/hinten (mit Umschalt: ganz)&#10;• Strg+Z / Strg+Y: rückgängig / wiederholen&#10;• Strg+Mausrad: zoomen (Zoomfeld: Prozent eintippen, 20 … 1000 %)&#10;• Mittlere Maustaste ziehen: Ansicht verschieben&#10;• Pfeilkreuz („Ansicht verschieben“) an: Ziehen verschiebt, zwei Finger zoomen&#10;• Doppelpfeil: Seite in die Breite einpassen&#10;• „Testen“ (F8): Flächen antippen wie mit dem Stift" />
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border x:Name="CanvasPanel" Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
            <DockPanel>
              <Border DockPanel.Dock="Top" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="10,6">
                <WrapPanel Classes="canvastools" Orientation="Horizontal">
                  <Button Classes="tool" Command="{Binding UndoCommand}" IsEnabled="{Binding Project.History.CanUndo}"
                          ToolTip.Tip="Rückgängig (Strg+Z)">
                    <PathIcon Data="{StaticResource IconUndo}" />
                  </Button>
                  <Button Classes="tool" Command="{Binding RedoCommand}" IsEnabled="{Binding Project.History.CanRedo}"
                          ToolTip.Tip="Wiederholen (Strg+Y)">
                    <PathIcon Data="{StaticResource IconRedo}" />
                  </Button>
                  <Button Classes="tool" Command="{Binding DeleteSelectionCommand}"
                          IsEnabled="{Binding Project.SelectedPage.HasSelection, FallbackValue=False}"
                          ToolTip.Tip="Gewählte Flächen, Bilder, Texte und Farbflächen löschen (Entf)">
                    <PathIcon Data="{StaticResource IconDelete}" />
                  </Button>
                  <Border Width="1" Background="{StaticResource CardBorder}" Margin="6,6" />
                  <Button Classes="tool" Command="{Binding InsertImageCommand}" ToolTip.Tip="Foto oder Bild einfügen">
                    <StackPanel><PathIcon Data="{StaticResource IconImage}" /><TextBlock Text="Bild" /></StackPanel>
                  </Button>
                  <Button Classes="tool" Command="{Binding InsertImmichImageCommand}" ToolTip.Tip="Fotos aus Immich (eigener Fotoserver) einfügen – mit den Namen der Personen darauf">
                    <StackPanel><PathIcon Data="{StaticResource IconImage}" /><TextBlock Text="Immich" /></StackPanel>
                  </Button>
                  <Button Classes="tool" Command="{Binding InsertTextCommand}" ToolTip.Tip="Text einfügen">
                    <StackPanel><PathIcon Data="{StaticResource IconText}" /><TextBlock Text="Text" /></StackPanel>
                  </Button>
                  <Button Classes="tool" Command="{Binding InsertShapeCommand}"
                          ToolTip.Tip="Farbige Fläche (Rechteck, Kreis/Ellipse oder Polygon) einfügen – unter OID-Flächen möglichst helle Farben wählen, sonst erkennt der Stift die Codes schlecht">
                    <StackPanel><PathIcon Data="{StaticResource IconColorShape}" /><TextBlock Text="Farbfläche" /></StackPanel>
                  </Button>
                  <ToggleButton Classes="tool" IsChecked="{Binding TestMode}"
                                ToolTip.Tip="Testen: Flächen antippen wie mit dem Stift – spielt ab und führt die Skripte aus (F8)">
                    <StackPanel><PathIcon Data="{StaticResource IconTap}" /><TextBlock Text="Testen" /></StackPanel>
                  </ToggleButton>
                  <ToggleButton Classes="tool" IsChecked="{Binding AreasOnly}" Margin="4,0"
                                ToolTip.Tip="Bilder, Texte und Farbflächen sperren, um darauf OID-Flächen zu zeichnen">
                    <StackPanel><PathIcon Data="{StaticResource IconArea}" /><TextBlock Text="Nur OID-Flächen" /></StackPanel>
                  </ToggleButton>
                  <ToggleButton Classes="tool" IsChecked="{Binding MultiSelect}"
                                ToolTip.Tip="Mehrere wählen: Antippen nimmt Objekte in die Auswahl auf oder entfernt sie (wie Strg-Klick)">
                    <StackPanel><PathIcon Data="{StaticResource IconSelectMultiple}" /><TextBlock Text="Mehrere wählen" /></StackPanel>
                  </ToggleButton>
                  <Border Width="1" Background="{StaticResource CardBorder}" Margin="6,6" />
                  <ToggleButton Classes="tool" IsChecked="{Binding RectangleTool}"
                                ToolTip.Tip="Neue OID-Flächen als Rechteck aufziehen">
                    <PathIcon Data="{StaticResource IconShapeRect}" />
                  </ToggleButton>
                  <ToggleButton Classes="tool" IsChecked="{Binding EllipseTool}"
                                ToolTip.Tip="Neue OID-Flächen als Kreis oder Ellipse aufziehen (Umschalt = Kreis)">
                    <PathIcon Data="{StaticResource IconShapeCircle}" />
                  </ToggleButton>
                  <ToggleButton Classes="tool" IsChecked="{Binding PolygonTool}"
                                ToolTip.Tip="Neue OID-Flächen als Polygon: Ecken anklicken, Doppelklick, Eingabetaste oder Klick auf die erste Ecke schließt ab">
                    <PathIcon Data="{StaticResource IconShapePolygon}" />
                  </ToggleButton>
                  <ToggleButton Classes="tool" IsChecked="{Binding DrawColorShapes}"
                                ToolTip.Tip="Mit den Werkzeugen Farbflächen statt OID-Flächen zeichnen (Farbe wie zuletzt gewählt)">
                    <PathIcon Data="{StaticResource IconColorShape}" />
                  </ToggleButton>
                  <Border Width="1" Background="{StaticResource CardBorder}" Margin="6,6" />
                  <Button Classes="tool" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Verkleinern">
                    <PathIcon Data="{StaticResource IconRemove}" />
                  </Button>
                  <TextBox x:Name="ZoomBox" Width="74" MinWidth="0" VerticalAlignment="Center" HorizontalContentAlignment="Right"
                           Text="{Binding ZoomText, UpdateSourceTrigger=LostFocus}"
                           ToolTip.Tip="Zoom in Prozent (20 … 1000), Eingabetaste übernimmt" />
                  <Button Classes="tool" Command="{Binding ZoomInCommand}" ToolTip.Tip="Vergrößern">
                    <PathIcon Data="{StaticResource IconAdd}" />
                  </Button>
                  <Button x:Name="FitButton" Classes="tool" ToolTip.Tip="Seite in die Breite einpassen">
                    <PathIcon Data="{StaticResource IconFit}" />
                  </Button>
                  <ToggleButton x:Name="PanToggle" Classes="tool"
                                ToolTip.Tip="Ansicht verschieben: Ziehen schiebt die Seite statt zu zeichnen, zwei Finger zoomen">
                    <PathIcon Data="{StaticResource IconPan}" />
                  </ToggleButton>
                </WrapPanel>
              </Border>
              <ScrollViewer x:Name="PageScroll" Background="{StaticResource CanvasBackground}"
                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Border Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top">
                  <views:PageCanvas x:Name="PageView" Page="{Binding Project.SelectedPage}" Zoom="{Binding Zoom}"
                                    AreasOnly="{Binding AreasOnly}" CropMode="{Binding CropMode}"
                                    AreaTool="{Binding AreaTool}" MultiSelect="{Binding MultiSelect}"
                                    DrawColorShapes="{Binding DrawColorShapes}"
                                    TestMode="{Binding TestMode}" TestTapCommand="{Binding TestTapCommand}" />
                </Border>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Border x:Name="PropertiesPanel" Grid.Column="4" Classes="card" Padding="0">
            <ScrollViewer>
              <Panel>
              <!-- Testmodus -->
              <StackPanel Margin="14,12" IsVisible="{Binding TestMode}">
                <TextBlock Classes="section" Text="Testen" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="Flächen auf der Seite antippen wie mit dem Stift: Die Skripte laufen, Register zählen mit, Texte und Aufnahmen werden abgespielt. Bearbeiten ist solange gesperrt." />
                <WrapPanel Margin="0,8,0,0">
                  <Button Command="{Binding TestRestartCommand}" Margin="0,0,6,6"
                          ToolTip.Tip="Wie Antippen des Produkt-Codes: Register auf Startwerte, Begrüßung abspielen">
                    <StackPanel><PathIcon Data="{StaticResource IconPlay}" /><TextBlock Text="Neu starten" /></StackPanel>
                  </Button>
                  <Button Command="{Binding TestReplayCommand}" Margin="0,0,6,6" Content="Wiederholen" />
                  <Button Command="{Binding TestStopCommand}" Margin="0,0,6,6">
                    <StackPanel><PathIcon Data="{StaticResource IconStop}" /><TextBlock Text="Stopp" /></StackPanel>
                  </Button>
                </WrapPanel>
                <TextBlock Classes="label" Text="Register" />
                <SelectableTextBlock Classes="hint" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                     Text="{Binding TestRegisters}" />
                <TextBlock Classes="label" Text="Ablauf (neueste oben)" />
                <SelectableTextBlock Classes="hint" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                     TextWrapping="Wrap" Text="{Binding TestTrace}" />
              </StackPanel>
              <StackPanel Margin="14,12" IsVisible="{Binding !TestMode}">
                <StackPanel IsVisible="{Binding !Project.SelectedPage.HasSelection, FallbackValue=True}">
                  <TextBlock Classes="section" Text="Auswahl" />
                  <TextBlock Classes="hint" Text="Nichts ausgewählt. Auf der Seite eine OID-Fläche, ein Bild oder einen Text anklicken – oder durch Ziehen auf freier Stelle eine neue OID-Fläche anlegen. Mit Strg- oder Umschalt-Klick lassen sich mehrere Objekte wählen." />
                </StackPanel>

                <!-- Mehrere Objekte -->
                <StackPanel IsVisible="{Binding Project.SelectedPage.IsMultiSelection, FallbackValue=False}">
                  <TextBlock Classes="section" Text="Auswahl" />
                  <TextBlock Classes="hint" Text="{Binding Project.SelectedPage.SelectionCaption, FallbackValue=''}" />
                  <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0"
                             Text="Ziehen oder Pfeiltasten verschieben alle gemeinsam. Strg- oder Umschalt-Klick nimmt Objekte hinzu oder heraus." />
                </StackPanel>

                <!-- Bild, Text oder Farbfläche -->
                <StackPanel DataContext="{Binding Project.SelectedPage.SelectedElement}" x:DataType="vm:ElementViewModel"
                            IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Classes="section" Text="Bild" IsVisible="{Binding IsImage}" />
                  <TextBlock Classes="section" Text="Text" IsVisible="{Binding IsText}" />
                  <TextBlock Classes="section" Text="Farbfläche" IsVisible="{Binding IsShape}" />
                  <StackPanel IsVisible="{Binding IsShape}">
                    <TextBlock Classes="label" Text="Form" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:AreaViewModel.ShapeOptions}"
                              SelectedItem="{Binding ShapeOption}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShapeOption">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="hint" Margin="0,4,0,0" IsVisible="{Binding IsPolygon}" TextWrapping="Wrap"
                               Text="Ecken ziehen: verschieben. Kreis in der Kantenmitte ziehen: Kante zum Bogen biegen (zurück zur Geraden ziehen = gerade). Doppelklick auf eine Ecke: löschen, auf eine Kantenmitte: neue Ecke." />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Unter OID-Flächen helle Farben wählen, auf dunklem Grund erkennt der Stift die Codes schlecht." />
                  </StackPanel>
                  <TextBlock Classes="hint" Text="{Binding FileName}" ToolTip.Tip="{Binding ImagePath}" IsVisible="{Binding IsImage}" />
                  <StackPanel IsVisible="{Binding IsImage}">
                    <TextBlock Classes="label" Text="Zuschnitt-Form" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:AreaViewModel.ShapeOptions}"
                              SelectedItem="{Binding ShapeOption}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShapeOption">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="hint" Margin="0,4,0,0" IsVisible="{Binding HasCropShape}" TextWrapping="Wrap"
                               Text="Das Bild wird innerhalb seines Rahmens zugeschnitten; für einen Kreis Breite und Höhe gleich setzen. „Ganzes Bild“ hebt den Zuschnitt auf." />
                    <TextBlock Classes="hint" Margin="0,4,0,0" IsVisible="{Binding IsPolygon}" TextWrapping="Wrap"
                               Text="Mit „Zuschneiden“: Ecken ziehen = verschieben, Kreis in der Kantenmitte ziehen = Kante biegen, Doppelklick auf eine Ecke = löschen, auf eine Kantenmitte = neue Ecke. Die Ecken bleiben innerhalb des Bilds." />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding IsText}">
                    <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,4,0,0" />
                    <TextBlock Classes="label" Text="Schriftart" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:ElementViewModel.FontNames}"
                              SelectedItem="{Binding FontChoice}" />
                    <TextBlock Classes="label" Text="Größe (pt)" />
                    <Grid ColumnDefinitions="*,8,Auto,Auto">
                      <TextBox Text="{Binding FontSize}" />
                      <CheckBox Grid.Column="2" Content="Fett" IsChecked="{Binding Bold}" Margin="0,0,8,0" />
                      <CheckBox Grid.Column="3" Content="Kursiv" IsChecked="{Binding Italic}" />
                    </Grid>
                    <TextBlock Classes="label" Text="Ausrichtung" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:ElementViewModel.AlignOptions}"
                              SelectedItem="{Binding AlignOption}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlignOption">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding HasColor}">
                    <TextBlock Classes="label" Text="Farbe" />
                    <Grid ColumnDefinitions="Auto,8,*">
                      <Border Width="28" Height="28" CornerRadius="4" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                              Background="{Binding ColorBrush}" />
                      <TextBox Grid.Column="2" Text="{Binding Color}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Static vm:ElementViewModel.ColorPresets}" Margin="0,6,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColorPreset">
                          <Button Width="24" Height="24" Padding="0" Margin="0,0,4,4" CornerRadius="4"
                                  BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                  Background="{Binding Brush}" ToolTip.Tip="{Binding Value}"
                                  Command="{Binding $parent[ItemsControl].((vm:ElementViewModel)DataContext).SetColorCommand}"
                                  CommandParameter="{Binding Value}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Ohne Füllung" Command="{Binding ClearFillCommand}" IsVisible="{Binding IsShape}"
                            ToolTip.Tip="Füllung durchsichtig machen, nur der Rand bleibt" />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding IsShape}">
                    <TextBlock Classes="label" Text="Rand: Breite (mm, 0 = ohne) und Farbe" />
                    <Grid ColumnDefinitions="70,8,Auto,8,*">
                      <TextBox Text="{Binding StrokeWidth}" />
                      <Border Grid.Column="2" Width="28" Height="28" CornerRadius="4" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                              Background="{Binding StrokeBrush}" />
                      <TextBox Grid.Column="4" Text="{Binding StrokeColor}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Static vm:ElementViewModel.ColorPresets}" Margin="0,6,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColorPreset">
                          <Button Width="24" Height="24" Padding="0" Margin="0,0,4,4" CornerRadius="4"
                                  BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                  Background="{Binding Brush}" ToolTip.Tip="{Binding Value}"
                                  Command="{Binding $parent[ItemsControl].((vm:ElementViewModel)DataContext).SetStrokeColorCommand}"
                                  CommandParameter="{Binding Value}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock Classes="label" Text="Position X / Y (mm)" />
                  <Grid ColumnDefinitions="*,8,*">
                    <TextBox Text="{Binding X}" />
                    <TextBox Grid.Column="2" Text="{Binding Y}" />
                  </Grid>
                  <TextBlock Classes="label" Text="Breite / Höhe (mm)" />
                  <Grid ColumnDefinitions="*,8,*">
                    <TextBox Text="{Binding Width}" />
                    <TextBox Grid.Column="2" Text="{Binding Height}" />
                  </Grid>
                  <TextBlock Classes="label" Text="Drehung (Grad)" />
                  <Grid ColumnDefinitions="*,6,Auto,Auto">
                    <TextBox Text="{Binding Rotation}" />
                    <Button Grid.Column="2" Classes="tool" Command="{Binding RotateCommand}" CommandParameter="-90"
                            ToolTip.Tip="90° nach links drehen">
                      <PathIcon Data="{StaticResource IconRotateLeft}" />
                    </Button>
                    <Button Grid.Column="3" Classes="tool" Command="{Binding RotateCommand}" CommandParameter="90"
                            ToolTip.Tip="90° nach rechts drehen">
                      <PathIcon Data="{StaticResource IconRotateRight}" />
                    </Button>
                  </Grid>
                </StackPanel>
                <StackPanel IsVisible="{Binding Project.SelectedPage.SelectedElement, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                  <TextBlock Classes="label" Text="Reihenfolge" />
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="tool" Command="{Binding SendToBackCommand}" ToolTip.Tip="Ganz nach hinten (Strg+Umschalt+Bild↓)">
                      <PathIcon Data="{StaticResource IconToBack}" />
                    </Button>
                    <Button Classes="tool" Command="{Binding SendBackwardCommand}" ToolTip.Tip="Eine Ebene nach hinten (Strg+Bild↓)">
                      <PathIcon Data="{StaticResource IconBackward}" />
                    </Button>
                    <Button Classes="tool" Command="{Binding BringForwardCommand}" ToolTip.Tip="Eine Ebene nach vorne (Strg+Bild↑)">
                      <PathIcon Data="{StaticResource IconForward}" />
                    </Button>
                    <Button Classes="tool" Command="{Binding BringToFrontCommand}" ToolTip.Tip="Ganz nach vorne (Strg+Umschalt+Bild↑)">
                      <PathIcon Data="{StaticResource IconToFront}" />
                    </Button>
                  </StackPanel>
                </StackPanel>
                <WrapPanel Classes="buttons" Margin="0,10,0,0"
                           IsVisible="{Binding Project.SelectedPage.SelectedElement, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                  <ToggleButton IsChecked="{Binding CropMode}" Margin="0,0,6,6"
                                IsVisible="{Binding Project.SelectedPage.SelectedElement.IsImage, FallbackValue=False}"
                                ToolTip.Tip="Mit den Anfassern den sichtbaren Ausschnitt ändern">
                    <StackPanel><PathIcon Data="{StaticResource IconCrop}" /><TextBlock Text="Zuschneiden" /></StackPanel>
                  </ToggleButton>
                  <Button Content="Ganzes Bild" Command="{Binding Project.SelectedPage.SelectedElement.ResetCropCommand, FallbackValue={x:Null}}"
                          IsVisible="{Binding Project.SelectedPage.SelectedElement.IsImage, FallbackValue=False}"
                          ToolTip.Tip="Zuschnitt aufheben" />
                  <Button Command="{Binding DetectPersonsCommand}"
                          IsVisible="{Binding Project.SelectedPage.SelectedElement.CanDetectPersons, FallbackValue=False}"
                          ToolTip.Tip="Personen auf dem Bild erkennen und für jede eine OID-Fläche mit eigenem Text anlegen (bei Fotos aus Immich mit den Gesichtern und Namen von dort)">
                    <StackPanel><PathIcon Data="{StaticResource IconPerson}" /><TextBlock Text="Personen erkennen" /></StackPanel>
                  </Button>
                  <Button Content="Auf Seite einpassen" Command="{Binding FitElementToPageCommand}" />
                  <Button Command="{Binding DuplicateElementCommand}">
                    <StackPanel><PathIcon Data="{StaticResource IconCopy}" /><TextBlock Text="Duplizieren" /></StackPanel>
                  </Button>
                  <Button Classes="danger" Command="{Binding DeleteElementCommand}">
                    <StackPanel><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Löschen" /></StackPanel>
                  </Button>
                </WrapPanel>

                <!-- OID-Fläche -->
                <StackPanel DataContext="{Binding Project.SelectedPage.SelectedArea}" x:DataType="vm:AreaViewModel"
                            IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Classes="section" Text="OID-Fläche" />
                  <TextBlock Classes="label" Text="Beschriftung (optional)" Margin="0,4,0,4" />
                  <TextBox Text="{Binding Label}" />
                  <TextBlock Classes="label" Text="Ziel" />
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:AreaViewModel.TargetOptions}"
                            SelectedItem="{Binding TargetOption}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:TargetOption">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel IsVisible="{Binding IsScriptMode}">
                    <TextBlock Classes="label" Text="Skript" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Project.ScriptNames}" SelectedItem="{Binding Script}" />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding IsSpeakMode}">
                    <TextBlock Classes="label" Text="Text (wird direkt abgespielt)" />
                    <Grid ColumnDefinitions="*,4,Auto">
                      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Project.Speak}" SelectedItem="{Binding SpeakEntry}"
                                PlaceholderText="– Text wählen –"
                                ToolTip.Tip="Die Fläche spielt diesen Text ab (Skript „P(name)“ wird angelegt bzw. verwendet)">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:SpeakViewModel">
                            <TextBlock TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text}" />
                            </TextBlock>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="2" Classes="tool" ToolTip.Tip="Neuer Text für diese Fläche"
                              Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).NewSpeakForAreaCommand}">
                        <PathIcon Data="{StaticResource IconAdd}" />
                      </Button>
                    </Grid>
                    <StackPanel IsVisible="{Binding HasSpeakEntry}" Margin="0,4,0,0">
                      <TextBlock Classes="label" Text="Name" Margin="0,0,0,4" />
                      <TextBox Classes="commit" Text="{Binding SpeakEntry.EditName, UpdateSourceTrigger=LostFocus, FallbackValue=''}" Margin="0,0,0,4"
                               ToolTip.Tip="Name, mit dem Skripte den Text abspielen (P(name)); Umbenennen passt die Skripte an. Erlaubt: Buchstaben, Ziffern, _ und ." />
                      <Grid ColumnDefinitions="*,4,Auto">
                        <TextBox Text="{Binding SpeakEntry.Text, FallbackValue=''}" AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="Text, den der Stift spricht"
                                 IsVisible="{Binding !SpeakEntry.HasRecording, FallbackValue=True}" />
                        <!-- Mit eigener Aufnahme statt Sprachausgabe -->
                        <Border IsVisible="{Binding SpeakEntry.HasRecording, FallbackValue=False}" Background="#E8F5E9" CornerRadius="4"
                                Padding="8,4" ToolTip.Tip="{Binding SpeakEntry.Recording, FallbackValue=''}">
                          <DockPanel VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Classes="tool" Padding="4" Margin="4,0,-6,0"
                                    ToolTip.Tip="Aufnahme entfernen (wieder die Sprachausgabe verwenden)"
                                    Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).RemoveRecordingCommand}"
                                    CommandParameter="{Binding SpeakEntry}">
                              <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                            </Button>
                            <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconMic}" Width="14" Height="14"
                                      Foreground="#2E7D32" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SpeakEntry.RecordingName, FallbackValue=''}" Foreground="#2E7D32"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </DockPanel>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                          <Button Classes="tool" ToolTip.Tip="Anhören" IsVisible="{Binding SpeakEntry.IsNotPlaying, FallbackValue=True}"
                                  Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).PlaySpeakCommand}"
                                  CommandParameter="{Binding SpeakEntry}">
                            <PathIcon Data="{StaticResource IconPlay}" />
                          </Button>
                          <Button Classes="tool" ToolTip.Tip="Anhalten bzw. fortsetzen" IsVisible="{Binding SpeakEntry.IsPlaying, FallbackValue=False}"
                                  Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).PauseSpeakCommand}"
                                  CommandParameter="{Binding SpeakEntry}">
                            <Panel>
                              <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding !SpeakEntry.IsPaused, FallbackValue=True}" />
                              <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding SpeakEntry.IsPaused, FallbackValue=False}" />
                            </Panel>
                          </Button>
                          <Button Classes="tool" ToolTip.Tip="Wiedergabe beenden" IsVisible="{Binding SpeakEntry.IsPlaying, FallbackValue=False}"
                                  Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).StopSpeakCommand}"
                                  CommandParameter="{Binding SpeakEntry}">
                            <PathIcon Data="{StaticResource IconStop}" />
                          </Button>
                          <Button Classes="tool" ToolTip.Tip="Mit dem Mikrofon aufnehmen bzw. Aufnahme beenden"
                                  Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).RecordSpeakCommand}"
                                  CommandParameter="{Binding SpeakEntry}">
                            <Panel>
                              <PathIcon Data="{StaticResource IconMic}" IsVisible="{Binding !SpeakEntry.IsRecording, FallbackValue=True}" />
                              <PathIcon Data="{StaticResource IconStop}" Foreground="#C62828" IsVisible="{Binding SpeakEntry.IsRecording, FallbackValue=False}" />
                            </Panel>
                          </Button>
                          <Button Classes="tool" ToolTip.Tip="Audiodatei als Aufnahme übernehmen"
                                  Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).ImportRecordingCommand}"
                                  CommandParameter="{Binding SpeakEntry}">
                            <PathIcon Data="{StaticResource IconOpen}" />
                          </Button>
                        </StackPanel>
                      </Grid>
                      <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0"
                                 Text="Mikrofonknopf nimmt auf (noch einmal klicken beendet), Ordnerknopf übernimmt eine Audiodatei. Die Stimme im Tab „Sprachausgabe“." />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Classes="label" Text="OID-Code" />
                  <TextBlock Classes="value" Text="{Binding Oid, TargetNullValue='– (Skript fehlt)'}" />
                  <TextBlock Classes="label" Text="Form" />
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:AreaViewModel.ShapeOptions}"
                            SelectedItem="{Binding ShapeOption}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShapeOption">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="hint" Margin="0,4,0,0" IsVisible="{Binding IsPolygon}"
                             Text="Ecken ziehen: verschieben. Kreis in der Kantenmitte ziehen: Kante zum Bogen biegen (zurück zur Geraden ziehen = gerade). Doppelklick auf eine Ecke: löschen, auf eine Kantenmitte: neue Ecke." />
                  <TextBlock Classes="label" Text="Position X / Y (mm)" />
                  <Grid ColumnDefinitions="*,8,*">
                    <TextBox Text="{Binding X}" />
                    <TextBox Grid.Column="2" Text="{Binding Y}" />
                  </Grid>
                  <TextBlock Classes="label" Text="Breite / Höhe (mm)" />
                  <Grid ColumnDefinitions="*,8,*">
                    <TextBox Text="{Binding Width}" />
                    <TextBox Grid.Column="2" Text="{Binding Height}" />
                  </Grid>
                </StackPanel>
                <WrapPanel Classes="buttons" Margin="0,14,0,0"
                           IsVisible="{Binding Project.SelectedPage.SelectedArea, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                  <Button Command="{Binding EditAreaScriptCommand}">
                    <StackPanel><PathIcon Data="{StaticResource IconEdit}" /><TextBlock Text="Skript bearbeiten" /></StackPanel>
                  </Button>
                  <Button Command="{Binding CreateScriptForAreaCommand}">
                    <StackPanel><PathIcon Data="{StaticResource IconAdd}" /><TextBlock Text="Neues Skript" /></StackPanel>
                  </Button>
                  <Button Command="{Binding DuplicateAreaCommand}">
                    <StackPanel><PathIcon Data="{StaticResource IconCopy}" /><TextBlock Text="Duplizieren" /></StackPanel>
                  </Button>
                  <Button Command="{Binding ExportAreaPngCommand}">
                    <StackPanel><PathIcon Data="{StaticResource IconImage}" /><TextBlock Text="Als PNG …" /></StackPanel>
                  </Button>
                  <Button Classes="danger" Command="{Binding DeleteAreaCommand}">
                    <StackPanel><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Löschen" /></StackPanel>
                  </Button>
                </WrapPanel>

                <!-- Ausrichten und Verteilen (ein Objekt an der Seite, mehrere aneinander) -->
                <StackPanel IsVisible="{Binding Project.SelectedPage.HasSelection, FallbackValue=False}">
                  <TextBlock Classes="label" Text="An der Seite ausrichten"
                             IsVisible="{Binding !Project.SelectedPage.IsMultiSelection, FallbackValue=False}" />
                  <TextBlock Classes="label" Text="Aneinander ausrichten"
                             IsVisible="{Binding Project.SelectedPage.IsMultiSelection, FallbackValue=False}" />
                  <WrapPanel>
                    <Button Classes="tool" Command="{Binding AlignCommand}" CommandParameter="Left" ToolTip.Tip="Links ausrichten">
                      <PathIcon Data="{StaticResource IconAlignLeft}" />
                    </Button>
                    <Button Classes="tool" Command="{Binding AlignCommand}" CommandParameter="CenterX" ToolTip.Tip="Horizontal zentrieren">
                      <PathIcon Data="{StaticResource IconAlignCenterX}" />
                    </Button>
                    <Button Classes="tool" Command="{Binding AlignCommand}" CommandParameter="Right" ToolTip.Tip="Rechts ausrichten">
                      <PathIcon Data="{StaticResource IconAlignRight}" />
                    </Button>
                    <Button Classes="tool" Command="{Binding AlignCommand}" CommandParameter="Top" ToolTip.Tip="Oben ausrichten">
                      <PathIcon Data="{StaticResource IconAlignTop}" />
                    </Button>
                    <Button Classes="tool" Command="{Binding AlignCommand}" CommandParameter="CenterY" ToolTip.Tip="Vertikal zentrieren">
                      <PathIcon Data="{StaticResource IconAlignCenterY}" />
                    </Button>
                    <Button Classes="tool" Command="{Binding AlignCommand}" CommandParameter="Bottom" ToolTip.Tip="Unten ausrichten">
                      <PathIcon Data="{StaticResource IconAlignBottom}" />
                    </Button>
                  </WrapPanel>
                  <StackPanel IsVisible="{Binding Project.SelectedPage.IsMultiSelection, FallbackValue=False}">
                    <TextBlock Classes="label" Text="Verteilen (ab drei Objekten)" />
                    <WrapPanel>
                      <Button Classes="tool" Command="{Binding DistributeCommand}" CommandParameter="Horizontal"
                              IsEnabled="{Binding Project.SelectedPage.CanDistribute, FallbackValue=False}"
                              ToolTip.Tip="Horizontal verteilen: gleiche Abstände, das linke und das rechte Objekt bleiben stehen">
                        <PathIcon Data="{StaticResource IconDistributeX}" />
                      </Button>
                      <Button Classes="tool" Command="{Binding DistributeCommand}" CommandParameter="Vertical"
                              IsEnabled="{Binding Project.SelectedPage.CanDistribute, FallbackValue=False}"
                              ToolTip.Tip="Vertikal verteilen: gleiche Abstände, das obere und das untere Objekt bleiben stehen">
                        <PathIcon Data="{StaticResource IconDistributeY}" />
                      </Button>
                    </WrapPanel>
                    <WrapPanel Classes="buttons" Margin="0,10,0,0">
                      <Button Classes="danger" Command="{Binding DeleteSelectionCommand}">
                        <StackPanel><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Alle löschen" /></StackPanel>
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              </Panel>
            </ScrollViewer>
          </Border>
        </Grid>
        </DockPanel>
      </TabItem>

      <!-- ================= Skripte ================= -->
      <TabItem Header="Skripte">
        <Grid x:Name="ScriptsGrid" ColumnDefinitions="250,12,*,12,340">
          <Border Grid.Column="0" Classes="card">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="section" Text="Skripte" />
              <WrapPanel DockPanel.Dock="Bottom" Classes="buttons">
                <Button Command="{Binding AddScriptCommand}">
                  <StackPanel><PathIcon Data="{StaticResource IconAdd}" /><TextBlock Text="Neues Skript" /></StackPanel>
                </Button>
                <Button Classes="danger" Command="{Binding RemoveScriptCommand}">
                  <StackPanel><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Löschen" /></StackPanel>
                </Button>
              </WrapPanel>
              <ListBox ItemsSource="{Binding Project.Scripts}" SelectedItem="{Binding Project.SelectedScript}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ScriptViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Margin="6,0,0,0" Foreground="{StaticResource TextSecondary}" Text="{Binding Code}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Classes="card">
            <Panel>
              <TextBlock Classes="hint" Text="Kein Skript ausgewählt."
                         IsVisible="{Binding Project.SelectedScript, Converter={x:Static ObjectConverters.IsNull}}" />
              <DockPanel DataContext="{Binding Project.SelectedScript}" x:DataType="vm:ScriptViewModel"
                         IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel DockPanel.Dock="Top">
                  <Grid ColumnDefinitions="*,16,Auto">
                    <StackPanel>
                      <TextBlock Classes="label" Text="Name" Margin="0,0,0,4" />
                      <TextBox Text="{Binding Name}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="label" Text="OID-Code" Margin="0,0,0,4" />
                      <TextBlock Classes="value" FontSize="18" Text="{Binding Code}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="label" Text="Zeilen (eine Bedingung/Aktion pro Zeile)" />
                </StackPanel>
                <TextBox Classes="code" AcceptsReturn="True" TextWrapping="NoWrap" Text="{Binding Text}" />
              </DockPanel>
            </Panel>
          </Border>

          <Border Grid.Column="4" Classes="card" Padding="0">
            <ScrollViewer>
              <StackPanel Margin="14,12">
                <TextBlock Classes="section" Text="Kurzreferenz (tttool)" />
                <SelectableTextBlock Classes="hint" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                           Text="P(name)        Ton/Text abspielen&#10;P(a,b)         zufällig einen abspielen&#10;P(&quot;a b.ogg&quot;)   Dateiname mit Sonderzeichen&#10;PA(a,b)        alle nacheinander&#10;P?(name)       vielleicht abspielen&#10;J(skript)      zu Skript springen&#10;$r := 1        Register setzen&#10;$r += 1        rechnen (-=, *=, /=, %=)&#10;$r == 1?       Bedingung (!=, &lt;, &gt;, &lt;=, &gt;=)&#10;&#10;Beispiel:&#10;$feld == 0? $feld := 1 P(ok)&#10;$feld == 1? P(schon_belegt)&#10;&#10;Jede Zeile wird von oben geprüft,&#10;die erste passende wird ausgeführt.&#10;&#10;Namen in P(...) beziehen sich auf&#10;die Sprachausgabe oder auf Audio-&#10;dateien im Medienverzeichnis." />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- ================= Sprachausgabe ================= -->
      <TabItem Header="Sprachausgabe">
        <Border Classes="card">
          <DockPanel>
          <!-- Aufnahme schneiden und Lautstärke ändern; oben, damit es auch bei langer Liste zu sehen ist -->
          <Border DockPanel.Dock="Top" IsVisible="{Binding IsEditingRecording}" Background="#E8F5E9" CornerRadius="6"
                  Padding="12" Margin="0,0,0,10">
            <StackPanel Spacing="8" DataContext="{Binding RecordingEditor}" x:DataType="vm:RecordingEditorViewModel">
              <TextBlock Classes="section" Text="{Binding Title, FallbackValue=''}" Margin="0" />
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="Anfang und Ende an den blauen Linien ziehen; was blass ist, wird abgeschnitten. Mit „Anhören“ lässt sich das Ergebnis vorher prüfen." />
              <views:WaveformView Height="110" Samples="{Binding Samples, FallbackValue={x:Null}}"
                                  Start="{Binding Start}" End="{Binding End}" Gain="{Binding Gain, FallbackValue=1}"
                                  Position="{Binding PlayPosition, FallbackValue=-1}" />
              <TextBlock Text="{Binding RangeText, FallbackValue=''}" />
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Text="Lautstärke" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider Grid.Column="1" Minimum="{x:Static vm:RecordingEditorViewModel.MinVolume}"
                        Maximum="{x:Static vm:RecordingEditorViewModel.MaxVolume}" Value="{Binding Volume}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding VolumeText, FallbackValue=''}" MinWidth="56" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="8,0" />
                <Button Grid.Column="3" Content="Automatisch" Command="{Binding NormalizeCommand}"
                        ToolTip.Tip="So laut wie die Sprachausgabe (wie „Lautstärke angleichen“)" />
              </Grid>
              <TextBlock IsVisible="{Binding Clips, FallbackValue=False}" Foreground="#C62828" TextWrapping="Wrap"
                         Text="Zu laut: Die rot markierten Stellen werden abgeschnitten und klingen verzerrt." />
              <WrapPanel Classes="buttons">
                <Button Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).PreviewRecordingEditCommand}">
                  <StackPanel><PathIcon Data="{StaticResource IconPlay}" /><TextBlock Text="Anhören" /></StackPanel>
                </Button>
                <Button Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).StopRecordingEditPreviewCommand}">
                  <StackPanel><PathIcon Data="{StaticResource IconStop}" /><TextBlock Text="Stopp" /></StackPanel>
                </Button>
                <Button Classes="accent" Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).ApplyRecordingEditCommand}">
                  <StackPanel><PathIcon Data="{StaticResource IconCut}" /><TextBlock Text="Übernehmen" /></StackPanel>
                </Button>
                <Button Command="{Binding ResetCommand}" ToolTip.Tip="Ganze Aufnahme in ursprünglicher Lautstärke">
                  <StackPanel><PathIcon Data="{StaticResource IconUndo}" /><TextBlock Text="Zurücksetzen" /></StackPanel>
                </Button>
                <Button Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).CancelRecordingEditCommand}">
                  <StackPanel><PathIcon Data="{StaticResource IconClose}" /><TextBlock Text="Abbrechen" /></StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </Border>
          <!-- Die ganze Seite scrollt, nicht nur die Liste (auf dem Handy bleibt sonst kaum Platz) -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <StackPanel>
              <TextBlock Classes="section" Text="Texte für die Sprachausgabe" />
              <TextBlock Classes="hint" Margin="0,0,0,6"
                         Classes.desktoponly="True"
                         Text="Texte werden beim Bauen der GME-Datei vorgelesen und eingebettet (Wiedergabeknopf = anhören). Statt der Sprachausgabe kann jeder Text eine eigene Aufnahme bekommen: Der Mikrofonknopf nimmt auf (noch einmal klicken beendet), der Ordnerknopf übernimmt eine Audiodatei (.wav, .ogg, .mp3), die Schere schneidet eine Aufnahme zu und macht sie lauter oder leiser. „Lautstärke angleichen“ bringt alle Aufnahmen auf die Lautstärke der Sprachausgabe. Aufnahmen liegen im Projektordner unter aufnahmen/." />
              <StackPanel IsVisible="{x:Static vm:MainWindowViewModel.HasVoices}" Margin="0,2,0,4">
                <TextBlock Classes="label" Text="Stimme des Projekts" />
                <ComboBox Classes="voice" MinWidth="320" ItemsSource="{Binding Project.VoiceOptions}"
                          SelectedValueBinding="{ReflectionBinding Id}" SelectedValue="{Binding Project.Voice}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="gme:VoiceOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="hint" Margin="0,4,0,0"
                           Text="Jeder Text kann eine eigene Stimme bekommen, z. B. für verschiedene Figuren. Jede Stimme wird beim ersten Gebrauch geladen (20–110 MB) und danach im Browser gespeichert." />
              </StackPanel>
              <CheckBox Content="Rauschen bei Aufnahmen unterdrücken" IsChecked="{Binding Project.DenoiseRecordings}"
                        ToolTip.Tip="Senkt gleichmäßiges Hintergrundrauschen (Lüfter, Mikrofon, Brummen) in neuen Mikrofonaufnahmen ab. Übernommene Audiodateien bleiben unverändert." />
              <WrapPanel Classes="buttons">
                <Button Command="{Binding AddSpeakCommand}">
                  <StackPanel><PathIcon Data="{StaticResource IconAdd}" /><TextBlock Text="Neuer Text" /></StackPanel>
                </Button>
                <Button Classes="danger" Command="{Binding RemoveSpeakCommand}">
                  <StackPanel><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Löschen" /></StackPanel>
                </Button>
                <Button Command="{Binding LevelRecordingsCommand}"
                        ToolTip.Tip="Bringt alle Aufnahmen auf die gleiche Lautstärke, so laut wie die Sprachausgabe (zu leise werden lauter, zu laute leiser)">
                  <StackPanel><PathIcon Data="{StaticResource IconLevel}" /><TextBlock Text="Lautstärke angleichen" /></StackPanel>
                </Button>
              </WrapPanel>
              <Grid Classes="speakheader" ColumnDefinitions="Auto,*,Auto" Margin="10,6,10,2">
                <TextBlock Classes="label speakname" Text="Name" Margin="0" />
                <TextBlock Classes="label" Grid.Column="1" Text="Text bzw. Aufnahme" Margin="8,0,0,0" />
                <TextBlock Classes="label speakvoice" Grid.Column="2" Text="Stimme" Margin="4,0,118,0"
                           IsVisible="{x:Static vm:MainWindowViewModel.HasVoices}" />
              </Grid>
            </StackPanel>
            <ListBox ItemsSource="{Binding Project.Speak}" SelectedItem="{Binding Project.SelectedSpeak}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SpeakViewModel">
                  <!-- Breit: eine Zeile; auf dem Handy oben Name und Stimme, darunter Text und Knöpfe (Stile oben) -->
                  <Grid Classes="speakrow" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                    <TextBox Classes="speakname commit" Text="{Binding EditName, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0"
                             ToolTip.Tip="Name, mit dem Skripte den Text abspielen (P(name)); Umbenennen passt die Skripte an" />
                    <TextBox Classes="speaktext" Text="{Binding Text}" IsVisible="{Binding !HasRecording}" />
                    <Border Classes="speaktext" IsVisible="{Binding HasRecording}" Background="#E8F5E9" CornerRadius="4"
                            Padding="8,0" ToolTip.Tip="{Binding Recording}">
                      <DockPanel VerticalAlignment="Center">
                        <Button DockPanel.Dock="Right" Classes="tool" Padding="4" Margin="4,0,-6,0"
                                ToolTip.Tip="Aufnahme entfernen (wieder die Sprachausgabe verwenden)"
                                Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).RemoveRecordingCommand}"
                                CommandParameter="{Binding}">
                          <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                        </Button>
                        <Button DockPanel.Dock="Right" Classes="tool" Padding="4" Margin="4,0,0,0"
                                ToolTip.Tip="Aufnahme schneiden bzw. lauter oder leiser machen"
                                Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).EditRecordingCommand}"
                                CommandParameter="{Binding}">
                          <PathIcon Data="{StaticResource IconCut}" Width="14" Height="14" />
                        </Button>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconMic}" Width="14" Height="14"
                                  Foreground="#2E7D32" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding RecordingName}" Foreground="#2E7D32" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                    <ComboBox Grid.Column="2" Classes="speakvoice" Margin="4,0,0,0"
                              IsVisible="{x:Static vm:MainWindowViewModel.HasVoices}" IsEnabled="{Binding !HasRecording}"
                              ItemsSource="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).Project.SpeakVoiceOptions}"
                              SelectedValueBinding="{ReflectionBinding Id}" SelectedValue="{Binding Voice}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="gme:VoiceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="3" Classes="speakbuttons" Orientation="Horizontal" Margin="4,0,0,0">
                      <Button Classes="tool" ToolTip.Tip="Anhören" IsVisible="{Binding IsNotPlaying, FallbackValue=True}"
                              Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).PlaySpeakCommand}"
                              CommandParameter="{Binding }">
                        <PathIcon Data="{StaticResource IconPlay}" />
                      </Button>
                      <Button Classes="tool" ToolTip.Tip="Anhalten bzw. fortsetzen" IsVisible="{Binding IsPlaying, FallbackValue=False}"
                              Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).PauseSpeakCommand}"
                              CommandParameter="{Binding }">
                        <Panel>
                          <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding !IsPaused, FallbackValue=True}" />
                          <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding IsPaused, FallbackValue=False}" />
                        </Panel>
                      </Button>
                      <Button Classes="tool" ToolTip.Tip="Wiedergabe beenden" IsVisible="{Binding IsPlaying, FallbackValue=False}"
                              Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).StopSpeakCommand}"
                              CommandParameter="{Binding }">
                        <PathIcon Data="{StaticResource IconStop}" />
                      </Button>
                      <Button Classes="tool" ToolTip.Tip="Mit dem Mikrofon aufnehmen bzw. Aufnahme beenden"
                              Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).RecordSpeakCommand}"
                              CommandParameter="{Binding}">
                        <Panel>
                          <PathIcon Data="{StaticResource IconMic}" IsVisible="{Binding !IsRecording}" />
                          <PathIcon Data="{StaticResource IconStop}" Foreground="#C62828" IsVisible="{Binding IsRecording}" />
                        </Panel>
                      </Button>
                      <Button Classes="tool" ToolTip.Tip="Audiodatei als Aufnahme übernehmen"
                              Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).ImportRecordingCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IconOpen}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          </ScrollViewer>
          </DockPanel>
        </Border>
      </TabItem>

      <!-- ================= Projekt ================= -->
      <TabItem Header="Projekt">
        <ScrollViewer>
          <Grid x:Name="ProjectGrid" ColumnDefinitions="*,12,*" DataContext="{Binding Project}" x:DataType="vm:ProjectViewModel"
                MaxWidth="1100" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border Grid.Column="0" Classes="card" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Classes="section" Text="Produkt" />
                <TextBlock Classes="label" Text="Produkt-ID" Margin="0,4,0,4" />
                <TextBox Text="{Binding ProductId}" />
                <TextBlock Classes="hint" Margin="0,4,0,0" Text="Muss zum Antippen des Produkt-Codes passen und sollte nicht mit originalen Ravensburger-Produkten kollidieren (z. B. 900–999)." />
                <TextBlock Classes="label" Text="Kommentar" />
                <TextBox Text="{Binding Comment}" />
                <TextBlock Classes="label" Text="Begrüßung (welcome)" />
                <TextBox Text="{Binding Welcome}" />
                <TextBlock Classes="hint" Margin="0,4,0,0" Text="Kommagetrennte Liste von Texten/Audiodateien, die beim Anmelden abgespielt werden." />
                <Border IsVisible="{Binding HasWelcomeProblem}" Background="#FFF3E0" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding WelcomeProblem}" Foreground="#E65100" TextWrapping="Wrap" FontSize="12" />
                    <Button Command="{Binding WelcomeAsTextCommand}" HorizontalAlignment="Left"
                            ToolTip.Tip="Legt den Satz als neuen Text „begruessung“ an (Tab „Sprachausgabe“) und trägt hier dessen Namen ein">
                      <StackPanel><PathIcon Data="{StaticResource IconAdd}" /><TextBlock Text="Als Text anlegen" /></StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
                <TextBlock Classes="label" Text="Initialisierung (init)" />
                <TextBox Classes="code" Text="{Binding Init}" />
                <TextBlock Classes="label" Text="Sprache für Text-to-Speech (language)" />
                <TextBox Text="{Binding Language}" />
                <TextBlock Classes="label" Text="GME-Sprache (gme-lang, optional)" />
                <TextBox Text="{Binding GmeLang}" />
                <TextBlock Classes="label" Text="Medienverzeichnis (media-path, optional)" />
                <TextBox Text="{Binding MediaPath}" />
                <TextBlock Classes="hint" Margin="0,4,0,0" Text="z. B. audio/%s – %s wird durch den Namen ersetzt." />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Classes="section" Text="GME-Erstellung und Druck" />
                <StackPanel IsVisible="{x:Static vm:MainWindowViewModel.IsDesktop}">
                  <CheckBox Content="GME mit externem tttool bauen" IsChecked="{Binding UseTttool}" />
                  <TextBlock Classes="hint" Text="Normalerweise nicht nötig: Der Designer baut GME-Dateien selbst. tttool (github.com/entropia/tip-toi-reveng) wird nur für Spiele und Timer unter „Weitere YAML-Einträge“ gebraucht." />
                  <TextBlock Classes="label" Text="Pfad zu tttool" IsVisible="{Binding UseTttool}" />
                  <TextBox Text="{Binding TttoolPath}" IsVisible="{Binding UseTttool}" />
                </StackPanel>
                <TextBlock Classes="label" Text="Druckauflösung (dpi) / Punktgröße (Pixel)" />
                <Grid ColumnDefinitions="*,8,*">
                  <TextBox Text="{Binding Dpi}" />
                  <TextBox Grid.Column="2" Text="{Binding PixelSize}" />
                </Grid>
                <TextBlock Classes="hint" Margin="0,4,0,0" Text="Standard: 1200 dpi, 2 Pixel. Werden Codes nicht erkannt, 600 dpi oder Punktgröße 3 probieren." />
                <CheckBox Margin="0,8,0,0" Content="Bilder ohne Schwarzanteil (CMYK)" IsChecked="{Binding CmykWithoutBlack}" />
                <TextBlock Classes="hint" Text="Bilder werden nur aus Cyan, Magenta und Gelb gemischt, Schwarz bleibt den Codes vorbehalten. Hilft, wenn der Stift auf dunklen Bildstellen falsch reagiert. Im Druckdialog die Farbanpassung abschalten; wirkt nur bei Druckern, die CMYK-Daten übernehmen (z. B. PostScript-Farblaser)." />
                <TextBlock Classes="label" Text="Wiederholen- / Stopp-Code" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock Classes="value" Text="{Binding Replay}" />
                  <TextBlock Classes="value" Text="{Binding Stop}" />
                </StackPanel>
                <TextBlock Classes="label" Text="Weitere YAML-Einträge (werden unverändert exportiert)" />
                <TextBox Classes="code" AcceptsReturn="True" Height="200" Text="{Binding ExtraYaml}" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- ================= Startbildschirm (Desktop ohne geöffnete Projektdatei) ================= -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowStartScreen}" Background="{StaticResource AppBackground}">
      <Border Classes="card" MaxWidth="560" Margin="16,48,16,16" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="Willkommen" />
          <TextBlock Classes="hint" Text="Jedes Projekt ist eine .tupfer-Datei mit allen Bildern und Aufnahmen." />
          <WrapPanel Orientation="Horizontal">
            <Button Margin="0,0,8,8" Command="{Binding NewProjectCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconNew}" Width="14" Height="14" />
                <TextBlock Text="Neues Projekt …" />
              </StackPanel>
            </Button>
            <Button Margin="0,0,8,8" Command="{Binding OpenProjectCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconOpen}" Width="14" Height="14" />
                <TextBlock Text="Projekt öffnen …" />
              </StackPanel>
            </Button>
            <Button Margin="0,0,8,8" Command="{Binding ImportYamlCommand}" Content="tttool-YAML importieren …" />
          </WrapPanel>
          <TextBlock Classes="label" Text="Zuletzt geöffnet" />
          <TextBlock Classes="hint" Text="Noch keine Projekte geöffnet." IsVisible="{Binding !HasRecentProjects}" />
          <ItemsControl ItemsSource="{Binding RecentProjects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentProject">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                        Background="Transparent" ToolTip.Tip="{Binding FilePath}"
                        Command="{Binding $parent[views:MainView].((vm:MainWindowViewModel)DataContext).OpenRecentCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- ================= Protokoll ================= -->
    <GridSplitter x:Name="LogSplitter" Grid.Row="2" Background="Transparent" ResizeDirection="Rows"
                  IsVisible="{Binding ShowLog}" />
    <Border x:Name="LogPanel" Grid.Row="3" Classes="card" IsVisible="{Binding ShowLog}" Margin="12,0,12,12" Padding="0" MinHeight="60">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,4,6,0">
          <TextBlock Classes="label" Text="PROTOKOLL" FontSize="11" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="tool" Command="{Binding HideLogCommand}" ToolTip.Tip="Protokoll schließen">
            <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
          </Button>
        </Grid>
        <TextBox IsReadOnly="True" TextWrapping="Wrap" Classes="code" FontSize="12" Text="{Binding LogText}" x:Name="LogBox"
                 BorderThickness="0" Background="Transparent" Padding="14,4,14,8" />
      </DockPanel>
    </Border>

    <!-- ================= Fotos aus Immich ================= -->
    <!-- Ebene über der ganzen Ansicht statt eines Fensters, damit es auch im Browser geht -->
    <Border Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsBrowsingImmich}" Background="#80000000">
      <Border Classes="card" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="16" Padding="20"
              MaxWidth="760" MaxHeight="720" DataContext="{Binding ImmichBrowser}" x:DataType="vm:ImmichBrowserViewModel">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Zugang …" Command="{Binding EditSettingsCommand}"
                    IsVisible="{Binding !ShowSettings}" ToolTip.Tip="Adresse und API-Key des Immich-Servers ändern" />
            <TextBlock Text="Fotos aus Immich" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
                <Button Classes="accent" MinWidth="90" HorizontalContentAlignment="Center" IsVisible="{Binding ShowPhotos}"
                        Command="{Binding InsertCommand}" IsEnabled="{Binding !IsBusy}">
                  <TextBlock Text="{Binding SelectedCount, StringFormat='Einfügen ({0})'}" />
                </Button>
                <Button Content="Schließen" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"
                        Command="{Binding CloseCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowPhotos}">
                <CheckBox Content="Original statt großer Vorschau" IsChecked="{Binding DownloadOriginal}"
                          ToolTip.Tip="Aus: große Vorschau von Immich (meist 1440 Pixel, reicht zum Drucken); an: Original in voller Auflösung (HEIC und RAW werden durch die Vorschau ersetzt)" />
                <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </StackPanel>

          <Panel>
            <!-- Zugang: Adresse und API-Key (werden in den Einstellungen gespeichert, nicht im Projekt) -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowSettings}">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                         Text="Adresse des Immich-Servers und ein API-Key (in Immich unter Kontoeinstellungen → API-Schlüssel; Rechte: album.read, person.read, asset.read, asset.view, asset.download, face.read). Beides wird in den Einstellungen dieses Programms gespeichert, nicht im Projekt." />
              <TextBlock Classes="label" Text="Adresse" />
              <TextBox Text="{Binding ServerUrl}" PlaceholderText="https://fotos.example.org"
                       IsReadOnly="{x:Static vm:ImmichBrowserViewModel.IsServerFixed}" />
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" IsVisible="{x:Static vm:ImmichBrowserViewModel.IsServerFixed}"
                         Text="In Nextcloud gilt der Immich-Server, den der Administrator eingetragen hat; die Zugriffe laufen über den Nextcloud-Server." />
              <TextBlock Classes="label" Text="API-Key" />
              <TextBox Text="{Binding ApiKey}" PasswordChar="•" />
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" IsVisible="{x:Static vm:ImmichBrowserViewModel.ShowCorsHint}"
                         Text="Hinweis für die Web-Version: Immich erlaubt Zugriffe von anderen Seiten (CORS) nur, wenn der Webserver vor Immich sie freigibt; läuft der Designer über https, muss auch Immich über https erreichbar sein. Ohne Freigabe geht es nur in der Desktop-Version (siehe README)." />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button Content="Verbinden" Classes="accent" IsDefault="True" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsBusy}" />
                <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <!-- Übersicht: Alben bzw. Personen -->
            <DockPanel IsVisible="{Binding ShowCollections}">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <RadioButton Content="Alben" GroupName="ImmichMode" IsChecked="{Binding AlbumMode}" />
                <RadioButton Content="Personen" GroupName="ImmichMode" IsChecked="{Binding PeopleMode}" />
                <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
              </StackPanel>
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Collections}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImmichItem">
                      <Button Width="132" Margin="0,0,8,8" Padding="4" Background="Transparent"
                              Command="{Binding $parent[ItemsControl].((vm:ImmichBrowserViewModel)DataContext).OpenCommand, FallbackValue={x:Null}}"
                              CommandParameter="{Binding}" ToolTip.Tip="{Binding Title}">
                        <StackPanel Orientation="Vertical" Spacing="2">
                          <Border Width="120" Height="120" CornerRadius="6" ClipToBounds="True" Background="{StaticResource CardBorder}">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          </Border>
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>

            <!-- Fotos eines Albums bzw. einer Person zum Ankreuzen -->
            <DockPanel IsVisible="{Binding ShowPhotos}">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="← Zurück" Command="{Binding BackCommand}" />
                <TextBlock Text="{Binding Current.Title, FallbackValue=''}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <ScrollViewer>
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Photos}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ImmichItem">
                        <ToggleButton Width="120" Height="120" Margin="0,0,6,6" Padding="3" IsChecked="{Binding IsChecked}"
                                      ToolTip.Tip="{Binding Title}">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Weitere Fotos laden" HorizontalAlignment="Center" Margin="0,6,0,0"
                          IsVisible="{Binding HasMore}" Command="{Binding LoadMoreCommand}" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Panel>
        </DockPanel>
      </Border>
    </Border>

    <!-- ================= Namen der erkannten Personen ================= -->
    <!-- Ebene über der ganzen Ansicht statt eines Fensters, damit es auch im Browser geht -->
    <Border Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsNamingPersons}" Background="#80000000">
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Padding="20"
              MaxWidth="520" MaxHeight="640">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Wer ist das?" FontSize="16" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       Text="Namen eingeben (von links nach rechts). Skript, Fläche und Text heißen dann wie die Person; ohne Namen bleibt es bei „Person 1“ …" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Übernehmen" Classes="accent" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center"
                    Command="{Binding ApplyPersonNamesCommand}" />
            <Button Content="Abbrechen" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"
                    Command="{Binding CancelPersonNamesCommand}" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl x:Name="PersonNameList" ItemsSource="{Binding PersonNameEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PersonNameEntry">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                    <Border Width="64" Height="64" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0"
                            Background="{StaticResource CardBorder}">
                      <Image Source="{Binding Face}" IsVisible="{Binding HasFace}" Stretch="UniformToFill" />
                    </Border>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}"
                             Watermark="{Binding Placeholder}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
